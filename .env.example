# PostgreSQL connection string. Never commit your real .env file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/delis_crm

# Required only for the first application start against an empty database.
# The first Owner is created once from these values; changing this file later
# does not overwrite an existing Owner credential.
OWNER_LOGIN=
OWNER_PASSWORD=
OWNER_NAME=Owner
OWNER_EMAIL=

# Required before enabling Owner TOTP two-factor authentication.
# Generate once and store securely: openssl rand -base64 32
# The value must decode to 32 bytes (or be a 64-character hex key).
TWO_FACTOR_ENCRYPTION_KEY=

# Optional. Demo operational data is disabled by default.
SEED_DEMO_DATA=false
