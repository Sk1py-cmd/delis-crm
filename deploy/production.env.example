# Copy to .env.production on the deployment host, fill it there, and chmod 600.
# Do not commit the resulting file.
DOMAIN=
ACME_EMAIL=

# Generate a URL-safe value: openssl rand -base64 36 | tr '+/' '-_' | tr -d '='
POSTGRES_PASSWORD=

# Used only for the first Owner bootstrap on an empty database.
OWNER_LOGIN=
OWNER_PASSWORD=
OWNER_NAME=Owner
OWNER_EMAIL=

# Required before enabling Owner TOTP. Generate once and retain securely:
# openssl rand -base64 32
TWO_FACTOR_ENCRYPTION_KEY=

# Optional exact public origins for a reverse proxy that cannot forward the
# original Host and protocol. Comma-separated; do not use wildcard origins.
# ALLOWED_WRITE_ORIGINS=https://crm.example.uz
